# Copy to .env locally. Never commit real credentials.
APP_ENV=development
APP_NAME=TRD Pro
APP_URL=http://localhost:5173
LOG_LEVEL=info

# Optional AI providers; configure only on a trusted server
GEMINI_API_KEY=
GROQ_API_KEY=
AI_DEFAULT_PROVIDER=

# Optional market data credentials; prefer public read-only endpoints
BINANCE_API_KEY=
BINANCE_API_SECRET=
MARKET_DATA_PROVIDER=

# OTC provider: configure only after verifying terms, provenance and quality
OTC_PROVIDER_BASE_URL=
OTC_PROVIDER_API_KEY=
